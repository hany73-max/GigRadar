# ==============================================================================
# GigRadar Environment Configuration Example
# Copy this file to .env and replace placeholder values.
# ==============================================================================

# LLM Configuration (Google Gemini API via official google-genai SDK)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL_SCORER=gemini-2.5-flash
LLM_MODEL_PITCH=gemini-2.5-flash
LLM_DAILY_CALL_BUDGET=200
LLM_MAX_RPM=10

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_ALLOWED_CHAT_ID=123456789

# Database Configuration (SQLite by default, PostgreSQL-ready)
DATABASE_URL=sqlite+aiosqlite:///gigradar.db

# Pipeline & Scoring Configuration
SCORE_THRESHOLD=65
AUTO_SUBMIT=false

# Platform Polling Intervals (in seconds)
POLL_INTERVAL_SECONDS_MOSTAQL=120
POLL_INTERVAL_SECONDS_KHAMSAT=180
POLL_INTERVAL_SECONDS_FREELANCER=120

# Freelancer.com specific (Optional)
FREELANCER_OAUTH_TOKEN=
FREELANCER_MONTHLY_BID_LIMIT=100

# Logging & Paths
LOG_LEVEL=INFO
LOG_FORMAT=console # console or json
CONFIG_DIR=config
